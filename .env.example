# Copy this file to `.env` and replace every `change_me` value.
# Put values that contain # or spaces in double quotes, e.g. PASSWORD="abc#123"
# (an unquoted # starts a comment).
# `.env` is gitignored: real credentials never go into Git.

# ---------- PostgreSQL (runs in Docker) ----------
POSTGRES_DB=research_platform
# Owner role: creates tables, runs migrations. Superuser inside the container.
POSTGRES_OWNER_USER=rp_owner
POSTGRES_OWNER_PASSWORD=change_me_owner
# Password for the least-privilege role `app_user` that the web app uses.
APP_DB_PASSWORD=change_me_app
POSTGRES_PORT=5432

# ---------- Neo4j (runs in Docker) ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Neo4j requires at least 8 characters.
NEO4J_PASSWORD=change_me_neo4j

# ---------- Connection strings used by the app and scripts ----------
# The web app connects as the least-privilege role (SELECT/INSERT/UPDATE/DELETE only).
DATABASE_URL=postgres://app_user:change_me_app@localhost:5432/research_platform
# Migrations connect as the owner role (CREATE/ALTER/DROP).
MIGRATION_DATABASE_URL=postgres://rp_owner:change_me_owner@localhost:5432/research_platform

# ---------- Authentication ----------
# Signs session cookies. Use a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=replace_with_a_long_random_string_of_at_least_32_chars

# First admin account, created by `npm run admin:create`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Platform Admin
SEED_ADMIN_PASSWORD=change_me_admin_password1

# ---------- Data import ----------
# Free key from https://openalex.org/settings/api (needed for `npm run data:import`)
OPENALEX_API_KEY=

# ---------- Uploads ----------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20
