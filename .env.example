# Copy this file to `.env` and replace every `change_me` value.
# `.env` is gitignored: real credentials never go into Git.

# ---------- PostgreSQL (runs in Docker) ----------
POSTGRES_DB=research_platform
# Owner role: creates tables, runs migrations. Superuser inside the container.
POSTGRES_OWNER_USER=rp_owner
POSTGRES_OWNER_PASSWORD=change_me_owner
# Password for the least-privilege role `app_user` that the web app uses.
APP_DB_PASSWORD=change_me_app
POSTGRES_PORT=5432

# ---------- Neo4j (runs in Docker) ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Neo4j requires at least 8 characters.
NEO4J_PASSWORD=change_me_neo4j
